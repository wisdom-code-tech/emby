#!/bin/bash

APP_ROOT="${TRIM_APPDEST}/server/emby-server"
APP_BINARY="${APP_ROOT}/system/EmbyServer"
GATEWAY_BINARY="${TRIM_APPDEST}/server/gateway-proxy"
GATEWAY_SOCKET="${TRIM_APPDEST}/emby.sock"
GATEWAY_PREFIX="/app/emby"
INTERNAL_PORT="8096"
PID_FILE="${TRIM_PKGTMP}/gateway.pid"
LOG_FILE="${TRIM_PKGVAR}/gateway.log"

report_error() {
  if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
    printf '%s\n' "$1" > "${TRIM_TEMP_LOGFILE}"
  fi
}

pid_matches_binary() {
  pid="$1"
  binary="$2"
  [ -n "${pid}" ] || return 1
  kill -0 "${pid}" 2>/dev/null || return 1
  [ -e "/proc/${pid}/exe" ] || return 1
  expected="$(readlink -f "${binary}" 2>/dev/null || printf '%s' "${binary}")"
  actual="$(readlink "/proc/${pid}/exe" 2>/dev/null || true)"
  actual="${actual% (deleted)}"
  [ "${actual}" = "${expected}" ]
}

read_gateway_pid() {
  [ -r "${PID_FILE}" ] || return 1
  candidate="$(head -n 1 "${PID_FILE}" | tr -cd '0-9')"
  pid_matches_binary "${candidate}" "${GATEWAY_BINARY}" || return 1
  printf '%s\n' "${candidate}"
}

find_binary_pids() {
  binary="$1"
  expected="$(readlink -f "${binary}" 2>/dev/null || printf '%s' "${binary}")"
  for proc_exe in /proc/[0-9]*/exe; do
    actual="$(readlink "${proc_exe}" 2>/dev/null || true)"
    actual="${actual% (deleted)}"
    [ "${actual}" = "${expected}" ] || continue
    proc_dir="${proc_exe%/exe}"
    printf '%s\n' "${proc_dir##*/}"
  done
}

descendant_pids() {
  parent="$1"
  for stat_file in /proc/[0-9]*/stat; do
    stat_line="$(cat "${stat_file}" 2>/dev/null || true)"
    [ -n "${stat_line}" ] || continue
    rest="${stat_line##*) }"
    process_parent="$(printf '%s\n' "${rest}" | awk '{print $2}')"
    [ "${process_parent}" = "${parent}" ] || continue
    proc_dir="${stat_file%/stat}"
    child="${proc_dir##*/}"
    descendant_pids "${child}"
    printf '%s\n' "${child}"
  done
}

stop_process_tree() {
  root_pid="$1"
  [ -n "${root_pid}" ] || return 0
  descendants="$(descendant_pids "${root_pid}")"
  for pid in ${descendants} ${root_pid}; do kill -TERM "${pid}" 2>/dev/null || true; done
  count=0
  while kill -0 "${root_pid}" 2>/dev/null && [ "${count}" -lt 35 ]; do
    state="$(awk '{print $3}' "/proc/${root_pid}/stat" 2>/dev/null || true)"
    [ "${state}" = "Z" ] && break
    sleep 1
    count=$((count + 1))
  done
  if kill -0 "${root_pid}" 2>/dev/null; then
    for pid in ${descendants} ${root_pid}; do kill -KILL "${pid}" 2>/dev/null || true; done
  fi
}

export_emby_environment() {
  export EMBY_DATA="${TRIM_PKGVAR}"
  export AMDGPU_IDS="${APP_ROOT}/extra/share/libdrm/amdgpu.ids"
  export FONTCONFIG_PATH="${APP_ROOT}/etc/fonts"
  export LD_LIBRARY_PATH="${APP_ROOT}/lib:${APP_ROOT}/extra/lib"
  export LIBVA_DRIVERS_PATH="${APP_ROOT}/extra/lib/dri"
  export OCL_ICD_VENDORS="${APP_ROOT}/extra/etc/OpenCL/vendors"
  export PATH="${APP_ROOT}/bin:${PATH}"
  export PCI_IDS_PATH="${APP_ROOT}/share/hwdata/pci.ids"
  export SSL_CERT_FILE="${APP_ROOT}/etc/ssl/certs/ca-certificates.crt"
  export XDG_CACHE_HOME="${TRIM_PKGTMP}/cache"
  export TMPDIR="${TRIM_PKGTMP}/transcoding"
  export HOME="${TRIM_PKGHOME}"
  export NEOReadDebugKeys=1
  export OverrideGpuAddressSpace=48
}

is_running() {
  gateway_pid="$(read_gateway_pid 2>/dev/null || true)"
  [ -n "${gateway_pid}" ] && [ -S "${GATEWAY_SOCKET}" ]
}

port_ready() {
  (exec 3<>"/dev/tcp/127.0.0.1/${INTERNAL_PORT}") >/dev/null 2>&1
}

cleanup_legacy_processes() {
  for pid in $(find_binary_pids "${GATEWAY_BINARY}"); do stop_process_tree "${pid}"; done
  for pid in $(find_binary_pids "${APP_BINARY}"); do stop_process_tree "${pid}"; done
  rm -f "${PID_FILE}" "${TRIM_PKGVAR}/emby.pid" "${TRIM_PKGVAR}/gateway.pid"
  [ ! -S "${GATEWAY_SOCKET}" ] || rm -f "${GATEWAY_SOCKET}"
}

start_app() {
  is_running && return 0
  for required_dir in "${TRIM_APPDEST}" "${TRIM_PKGVAR}" "${TRIM_PKGTMP}" "${TRIM_PKGHOME}"; do
    [ -d "${required_dir}" ] || {
      report_error "fnOS 应用目录不存在：${required_dir}"
      return 1
    }
  done
  [ -x "${APP_BINARY}" ] && [ -x "${GATEWAY_BINARY}" ] || {
    report_error "Emby 或统一网关代理缺失，请重新安装应用。"
    return 1
  }
  if [ -e "${GATEWAY_SOCKET}" ] && [ ! -S "${GATEWAY_SOCKET}" ]; then
    report_error "统一网关 Socket 路径被非 Socket 文件占用。"
    return 1
  fi

  cleanup_legacy_processes
  mkdir -p "${TRIM_PKGTMP}/cache" "${TRIM_PKGTMP}/transcoding"
  export_emby_environment
  umask 077
  "${GATEWAY_BINARY}" \
    -socket "${GATEWAY_SOCKET}" \
    -upstream "http://127.0.0.1:${INTERNAL_PORT}" \
    -prefix "${GATEWAY_PREFIX}" \
    -emby "${APP_BINARY}" \
    -emby-root "${APP_ROOT}" \
    -data "${EMBY_DATA}" >> "${LOG_FILE}" 2>&1 &
  gateway_pid=$!
  printf '%s\n' "${gateway_pid}" > "${PID_FILE}"

  count=0
  while { [ ! -S "${GATEWAY_SOCKET}" ] || ! port_ready; } && [ "${count}" -lt 70 ]; do
    pid_matches_binary "${gateway_pid}" "${GATEWAY_BINARY}" || break
    sleep 1
    count=$((count + 1))
  done
  if ! is_running; then
    cleanup_legacy_processes
    report_error "Emby 或统一网关启动失败，请检查 ${LOG_FILE}。"
    return 1
  fi
}

stop_app() {
  gateway_pid="$(read_gateway_pid 2>/dev/null || true)"
  if [ -n "${gateway_pid}" ]; then
    kill -TERM "${gateway_pid}" 2>/dev/null || true
    count=0
    while kill -0 "${gateway_pid}" 2>/dev/null && [ "${count}" -lt 40 ]; do
      state="$(awk '{print $3}' "/proc/${gateway_pid}/stat" 2>/dev/null || true)"
      [ "${state}" = "Z" ] && break
      sleep 1
      count=$((count + 1))
    done
    kill -KILL "${gateway_pid}" 2>/dev/null || true
  fi
  cleanup_legacy_processes
}

case "${1:-}" in
  start) start_app ;;
  stop) stop_app ;;
  cleanup) cleanup_legacy_processes ;;
  status) if is_running; then exit 0; else exit 3; fi ;;
  *) exit 1 ;;
esac
