#!/bin/bash

report_error() {
  if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
    printf '%s\n' "$1" > "${TRIM_TEMP_LOGFILE}"
  fi
}

empty_app_directory() {
  variable_name="$1"
  storage_name="$2"
  target="${!variable_name-}"
  [ -n "${target}" ] || {
    report_error "fnOS 未提供 ${variable_name}，已取消数据清理。"
    return 1
  }
  [ -e "${target}" ] || return 0
  resolved_target="$(readlink -f -- "${target}" 2>/dev/null || true)"
  printf '%s\n' "${resolved_target}" | grep -Eq "^/vol[0-9]+/${storage_name}/emby$" || {
    report_error "拒绝清理不符合 fnOS 应用目录规则的路径：${target}"
    return 1
  }
  [ -d "${resolved_target}" ] && [ ! -L "${resolved_target}" ] || {
    report_error "拒绝清理非目录路径：${target}"
    return 1
  }
  find "${resolved_target}" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
}

if [ "${wizard_data_action:-keep}" = "delete" ]; then
  empty_app_directory TRIM_PKGVAR @appdata || exit 1
  empty_app_directory TRIM_PKGETC @appconf || exit 1
  empty_app_directory TRIM_PKGHOME @apphome || exit 1
  empty_app_directory TRIM_PKGMETA @appmeta || exit 1
  empty_app_directory TRIM_PKGTMP @apptemp || exit 1
fi
exit 0
